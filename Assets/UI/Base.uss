/* NATION: WORLD ORDER - Phase 1 base styles.
   Dark command-center palette. Replaced by the token-based theme system in Phase 2. */

.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #060B18;
    align-items: center;
    overflow: hidden;
}

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.column {
    flex-grow: 1;
    width: 100%;
    max-width: 390px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 64px;
    padding-bottom: 36px;
}

/* ---------- typography ---------- */

.eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    color: rgba(150, 175, 215, 0.75);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.title--primary {
    font-size: 54px;
    letter-spacing: 14px;
    color: #F4F7FC;
}

.title--accent {
    font-size: 26px;
    letter-spacing: 9px;
    color: #7FB0FF;
    margin-top: 2px;
}

.tagline {
    font-size: 11px;
    letter-spacing: 2.5px;
    color: rgba(214, 224, 240, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 22px;
}

.footnote {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(150, 175, 215, 0.45);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.rule {
    height: 1px;
    width: 64px;
    align-self: center;
    background-color: rgba(127, 176, 255, 0.35);
    margin-top: 26px;
}

/* ---------- layout blocks ---------- */

.hero {
    flex-grow: 1;
    justify-content: center;
    align-items: stretch;
}

.menu {
    flex-shrink: 0;
    margin-top: 24px;
}

.spacer {
    flex-grow: 1;
}

/* ---------- buttons ---------- */

.btn {
    height: 56px;
    width: 100%;
    margin: 0 0 12px 0;
    padding: 0 20px 0 20px;
    border-radius: 14px;
    border-width: 1px;
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #E8EEF8;
    transition-property: background-color, border-color, scale;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.btn:active {
    scale: 0.97 0.97;
}

.btn--primary {
    background-color: #2B6BE0;
    border-color: #5E95F5;
    color: #FFFFFF;
}

.btn--primary:hover {
    background-color: #3878F0;
    border-color: #7FAEFF;
}

.btn--secondary {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

.btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.22);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgba(190, 205, 230, 0.7);
    height: 48px;
    margin-bottom: 0;
}

.btn--ghost:hover {
    color: #E8EEF8;
    background-color: rgba(255, 255, 255, 0.04);
}

/* ---------- modal card (COMING SOON) ---------- */

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.modal--visible {
    opacity: 1;
}

.modal__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 14, 0.78);
}

.modal__card {
    width: 100%;
    max-width: 330px;
    padding: 28px 24px 20px 24px;
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(127, 176, 255, 0.25);
    background-color: #0D1629;
    align-items: stretch;
    translate: 0 18px;
    transition-property: translate;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}

.modal--visible .modal__card {
    translate: 0 0;
}

.badge {
    align-self: center;
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: #7FB0FF;
    padding: 6px 12px 6px 12px;
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(127, 176, 255, 0.4);
    background-color: rgba(43, 107, 224, 0.15);
}

.modal__title {
    font-size: 24px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: #F4F7FC;
    -unity-text-align: middle-center;
    margin-top: 18px;
}

.modal__body {
    font-size: 13px;
    color: rgba(214, 224, 240, 0.75);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 24px;
}

/* ---------- world placeholder ---------- */

.hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px 14px 16px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.035);
}

.hud__identity {
    flex-direction: row;
    align-items: center;
}

.hud__country {
    font-size: 17px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: #F4F7FC;
    margin-left: 12px;
}

.hud__date {
    font-size: 12px;
    letter-spacing: 1px;
    color: #7FB0FF;
    -unity-text-align: middle-right;
}

.flag {
    width: 34px;
    height: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    overflow: hidden;
}

.flag__stripe {
    flex-grow: 1;
}

.flag__stripe--black { background-color: #1A1A1A; }
.flag__stripe--red   { background-color: #DD0000; }
.flag__stripe--gold  { background-color: #FFCE00; }

.stats {
    margin-top: 16px;
}

.stat-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 72px;
    padding: 0 20px 0 20px;
    margin-bottom: 10px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(255, 255, 255, 0.03);
}

.stat-card__label {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(150, 175, 215, 0.8);
}

.stat-card__value {
    font-size: 26px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: #F4F7FC;
}

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Base.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="column" class="column">
            <ui:VisualElement name="hud" class="hud">
                <ui:VisualElement class="hud__identity">
                    <!-- Phase 1 placeholder flag; Phase 3 renders flags from country data. -->
                    <ui:VisualElement name="flag" class="flag">
                        <ui:VisualElement class="flag__stripe flag__stripe--black" />
                        <ui:VisualElement class="flag__stripe flag__stripe--red" />
                        <ui:VisualElement class="flag__stripe flag__stripe--gold" />
                    </ui:VisualElement>
                    <ui:Label name="country-name" class="hud__country" />
                </ui:VisualElement>
                <ui:Label name="date" class="hud__date" />
            </ui:VisualElement>
            <ui:VisualElement name="stats" class="stats">
                <ui:VisualElement class="stat-card">
                    <ui:Label name="treasury-label" class="stat-card__label" />
                    <ui:Label name="treasury-value" class="stat-card__value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:Label name="gdp-label" class="stat-card__label" />
                    <ui:Label name="gdp-value" class="stat-card__value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-card">
                    <ui:Label name="population-label" class="stat-card__label" />
                    <ui:Label name="population-value" class="stat-card__value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:Label name="tick-info" class="footnote" style="margin-bottom: 14px;" />
            <ui:Button name="advance-day-button" class="btn btn--primary" />
            <ui:Button name="menu-button" class="btn btn--ghost" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
